<Project Sdk="MSTest.Sdk/4.0.1">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PySharp\PySharp.csproj" />
    <ProjectReference Include="..\PySharp.Tests.SourceGeneration\PySharp.Tests.SourceGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- The public [PyExport]/[PyModuleInclude] generators do not flow
         through the PySharp ProjectReference (analyzers are not transitive),
         so extension-surface tests wire them the same way the library does.
         Roslyn.Shared must ride along as an analyzer for the compiler to
         resolve the generator's dependency, mirroring PySharp.csproj. -->
    <ProjectReference Include="..\PySharp.Roslyn.Shared\PySharp.Roslyn.Shared.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\PySharp.SourceGeneration\PySharp.SourceGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="test_pyfiles\*.py" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="test_pyfiles\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="test_pyfiles\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PySharp.Analyzer.Style\PySharp.Analyzer.Style.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
