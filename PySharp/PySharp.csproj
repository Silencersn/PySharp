<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Authors>Silencersn</Authors>
    <Copyright>Copyright © 2025-2026 Silencersn. All rights reserved.</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU' Or '$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <IsTrimmable>True</IsTrimmable>
    <IsAotCompatible>True</IsAotCompatible>
    <EnableTrimAnalyzer>True</EnableTrimAnalyzer>
    <EnableAotAnalyzer>True</EnableAotAnalyzer>
</PropertyGroup>

  <ItemGroup>
    <!-- Build-time utilities shared by every generator/analyzer assembly. It is
         not itself an analyzer, but Roslyn resolves it as a dependency of the
         generator dll, so it must ship in the same packed directory. It is
         passed as an analyzer for the same reason the packed copy sits in
         analyzers/dotnet/cs: the compiler only probes that path for dependency
         dlls it was handed directly, never the directory of the dll that
         referenced them. -->
    <ProjectReference Include="..\PySharp.Roslyn.Shared\PySharp.Roslyn.Shared.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <None Include="..\PySharp.Roslyn.Shared\bin\$(Configuration)\netstandard2.0\PySharp.Roslyn.Shared.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PySharp.SourceGeneration\PySharp.SourceGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <None Include="..\PySharp.SourceGeneration\bin\$(Configuration)\netstandard2.0\PySharp.SourceGeneration.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PySharp.SourceGeneration.Internal\PySharp.SourceGeneration.Internal.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PySharp.Analyzer.Internal\PySharp.Analyzer.Internal.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PySharp.Analyzer\PySharp.Analyzer.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <None Include="..\PySharp.Analyzer\bin\$(Configuration)\netstandard2.0\PySharp.Analyzer.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Lib\**\*.py" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Modules\Warnings\" />
  </ItemGroup>

</Project>
