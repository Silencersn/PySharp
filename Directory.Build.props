<Project>

  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- Source generators write their output under each project's
         obj/<configuration>/<tfm>/generated/ so the generated sources are
         inspectable without a special build switch. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- Single source of truth for the release version; every project
         inherits it, including the bare dlls shipped in the main
         package's analyzers/ directory. -->
    <Version>0.52</Version>
    <!-- Single source of truth for the Roslyn toolchain. Every generator and
         analyzer project compiles against one host Roslyn version; a host that
         loads PySharp loads them side by side, so the effective floor is the
         highest of them, not the lowest. -->
    <RoslynVersion>5.0.0</RoslynVersion>
    <RoslynAnalyzersVersion>3.11.0</RoslynAnalyzersVersion>
  </PropertyGroup>

</Project>
